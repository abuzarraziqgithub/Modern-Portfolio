const labels: Record<string, string> = {
  github: 'GitHub',
  linkedin: 'LinkedIn',
  x: 'X',
  instagram: 'Instagram',
  youtube: 'YouTube',
  tiktok: 'TikTok',
  facebook: 'Facebook',
};
---

<section id="chat" class="section defer connect">
  <div class="shell">
    {connect.note && <p class="hand note">{connect.note}</p>}

    <button class="btn" popovertarget="dock">
      Connect
      <Doodle name="heartArrow" size={28} class="heart" />
    </button>

    <p class="status">
      {name} is open to internships and junior roles.
      {
        connect.resume && (
          <a href={`/${connect.resume}`} download>
            Download the CV
          </a>
        )
      }
    </p>
  </div>
</section>

<div id="dock" popover class="dock" aria-label="Contact links">
  <ul>
    <li>
      <a href={`mailto:${connect.email}`} aria-label={`Email ${name} at ${connect.email}`}>
        <span class="glyph" aria-hidden="true">@</span>
        <span class="tip">{connect.email}</span>
      </a>
    </li>
    {
      connect.socials.map((s) => (
        <li>
          <a href={s.url} rel="noopener me" aria-label={labels[s.name] ?? s.name}>
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
              <path d={icons[s.name]} />
            </svg>
            <span class="tip">{labels[s.name] ?? s.name}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <form method="dialog" class="close">
    <button aria-label="Close">Close</button>
  </form>
</div>

<style>
  .connect {
    text-align: center;
  }

  .note {
    font-size: clamp(1.4rem, 1.1rem + 1.4vw, 2.2rem);
    margin-block-end: 1.5rem;
  }

  /* Glossy 3D pill */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    border: 0;
    border-radius: var(--radius-pill);
    padding: 0.35em 1.1em 0.42em;
    font-family: var(--font);
    font-size: clamp(3rem, 12vw, 9rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    color: #fff;
    background: linear-gradient(#3a3a38, #1c1c1a);
    rotate: -3deg;
    cursor: pointer;
    box-shadow:
      0 0.06em 0 #000,
      0 0.12em 0 #555,
      0 0.3em 0.5em rgb(0 0 0 / 0.3);
    transition:
      translate 0.15s,
      box-shadow 0.15s,
      filter 0.3s;
  }

  :global(.heart) {
    translate: 0 -0.1em;
    transition: rotate 0.3s var(--spring);
  }

  .btn:active {
    translate: 0 0.05em;
    box-shadow:
      0 0.02em 0 #000,
      0 0.06em 0 #555,
      0 0.12em 0.3em rgb(0 0 0 / 0.3);
  }

  .btn:hover,
  .btn:focus-visible,
  .btn:active {
    filter: drop-shadow(0 0 0.35em var(--glow-1));
    color: var(--glow-1);
  }

  @media (hover: hover) {
    .btn:hover :global(.heart) {
      rotate: -8deg;
    }
  }

  .status {
    margin-block-start: 2.5rem;
    color: var(--muted);
  }

  .status a {
    margin-inline-start: 0.6rem;
  }

  /* Dock: popover, no JS. Esc closes it natively. */
  .dock {
    position: fixed;
    inset: auto 1rem 1rem;
    margin-inline: auto;
    max-width: 44rem;
    padding: 1.1rem;
    border: 0;
    border-radius: var(--radius-card);
    background: var(--page);
    box-shadow: var(--lift-3);
    translate: 0 120%;
    opacity: 0;
    transition:
      translate 0.5s var(--ease-out),
      opacity 0.3s,
      display 0.5s allow-discrete,
      overlay 0.5s allow-discrete;
  }

  .dock:popover-open {
    translate: 0 0;
    opacity: 1;
  }

  @starting-style {
    .dock:popover-open {
      translate: 0 120%;
      opacity: 0;
    }
  }

  /* Without popover support the dock is a plain block, so the links stay reachable. */
  @supports not selector(:popover-open) {
    .dock {
      position: static;
      translate: none;
      opacity: 1;
      margin: var(--pad) auto;
      max-width: var(--shell);
    }
  }

  .dock::backdrop {
    background: rgb(14 14 12 / 0.32);
    backdrop-filter: blur(2px);
  }

  .dock ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
  }

  .dock a {
    display: grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--card);
    text-decoration: none;
    transition: scale 0.25s var(--spring);
  }

  .glyph {
    font-weight: 600;
    font-size: 1.15rem;
  }

  .tip {
    position: absolute;
    translate: 0 140%;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--glow-1);
    font-size: var(--step--1);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
  }

  .dock a {
    position: relative;
  }

  .dock a:hover .tip,
  .dock a:focus-visible .tip {
    opacity: 1;
  }

  /* Magnify the icon under the pointer and its neighbours. */
  @media (hover: hover) {
    .dock li {
      transition: scale 0.25s var(--spring);
    }

    .dock li:hover {
      scale: 1.4;
      z-index: 1;
    }

    .dock li:hover + li,
    .dock li:has(+ li:hover) {
      scale: 1.18;
    }
  }

  .close {
    display: grid;
    justify-items: center;
    margin-block-start: 0.9rem;
  }

  .close button {
    border: 0;
    border-radius: var(--radius-pill);
    padding: 0.5rem 1.1rem;
    min-height: 44px;
    background: var(--card);
    color: var(--muted);
    cursor: pointer;
  }
</style>
