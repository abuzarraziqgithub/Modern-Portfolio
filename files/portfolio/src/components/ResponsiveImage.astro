---
// One image pipeline for every raster on the page: AVIF q55, WebP q80, and a
// fallback capped at the largest width the layout can actually use.
//
// astro:assets' <Picture> uses the source file unchanged as the <img src>
// fallback, so a 1919x997 PNG screenshot ships 427 KB to anything that ignores
// srcset and still fails the 220 KB budget even though every AVIF and WebP
// variant is under 50 KB. getImage() lets us cap the fallback and pick its
// format, which is what docs/PERFORMANCE.md asks for: "AVIF q55 with WebP
// fallback" and "Never upscale".
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  widths: number[];
  alt: string;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  decoding?: 'async' | 'sync' | 'auto';
  class?: string;
}

const {
  src,
  widths,
  alt,
  sizes,
  loading = 'lazy',
  fetchpriority,
  decoding = 'async',
  class: className,
} = Astro.props;

// Never upscale: drop any requested width wider than the source, then sort.
const w = [...new Set(widths.filter((n) => n <= src.width))].sort((a, b) => a - b);
if (w.length === 0) w.push(src.width);
const max = w[w.length - 1];
const height = Math.round((src.height / src.width) * max);

const avif = await getImage({ src, widths: w, sizes, format: 'avif', quality: 55 });
const webp = await getImage({ src, widths: w, sizes, format: 'webp', quality: 80 });
// Fallback is the largest width the layout uses, not the source, so a big
// screenshot cannot reappear as an oversized fallback.
const fallback = await getImage({ src, width: max, sizes, format: 'webp', quality: 80 });
---

<picture>
  <source type="image/avif" srcset={avif.srcSet.attribute} sizes={sizes} />
  <source type="image/webp" srcset={webp.srcSet.attribute} sizes={sizes} />
  <img
    src={fallback.src}
    width={max}
    height={height}
    alt={alt}
    loading={loading}
    decoding={decoding}
    fetchpriority={fetchpriority}
    class={className}
  />
</picture>

<style>
  /* The <picture> wrapper must not disturb the grid or flex boxes the images sit in. */
  picture {
    display: contents;
  }
</style>